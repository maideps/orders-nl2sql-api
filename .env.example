# Copy this file to .env and add your key. .env is listed in .gitignore.

# Key for the LLM provider (required)
LLM_API_KEY=

# Model that translates the question into SQL (optional, default: gpt-5-mini)
# LLM_MODEL=gpt-5-mini

# Any provider with an OpenAI-compatible API works. To use DeepSeek instead of OpenAI:
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-chat

# Path to the SQLite database (optional, default: data/orders.db)
# ORDERS_DB_PATH=data/orders.db
